# ==========================================
# OS & Environment Files
# ==========================================
.DS_Store
Thumbs.db
.env
.venv/
venv/
env/

# ==========================================
# Python & IDE Caches
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.vscode/
.idea/
.pytest_cache/

# ==========================================
# Jupyter Notebooks
# ==========================================
.ipynb_checkpoints/

# ==========================================
# Data & Large Media Files
# ==========================================

data/raw/
data/processed/
data/labels/
data/warehouse_dataset/
data/warehouse.yaml
data/mvp_dataset/
data/mvp_dataset_v2/
data/videos/*.mp4
!data/dataset.yaml

# ==========================================
# Outputs & Heavy ML Logs
# ==========================================
outputs/
mlruns/

# ==========================================
# Streamlit
# ==========================================
.streamlit/

# React build output and local dependencies
frontend/node_modules/
frontend/dist/

# Local downloads, screenshots, and large optional model assets
.downloads/
weights/clip/

# Keep selected evaluation artifacts, but avoid duplicate recovery checkpoints
runs/mvp/*/weights/last.pt
runs/mvp/person_carton_v1/weights/
runs/mvp/person_carton_v3_expanded/weights/

.vercel

# ==========================================
# Agent tooling (installed per machine, not project source)
# ==========================================
# The impeccable design skill is installed with `npx impeccable install`.
# It ships a platform-specific binary and is ~17 MB, so it is fetched rather
# than committed. `.claude/launch.json` is kept: it is the shared dev-server
# definition for this project.
.claude/skills/
.claude/agents/
.claude/settings.local.json

# Impeccable working files. The surface briefs under .impeccable/surfaces/
# hold the durable design contracts and ARE committed; these are caches.
.impeccable/hook.cache.json
.impeccable/questions/
.impeccable/mocks/
.impeccable/review/
.impeccable/config.local.json
